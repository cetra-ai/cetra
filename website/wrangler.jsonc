// The docs site as a Worker with static assets (D-W-3): no Worker script, only the built site.
// `just docs-deploy main` deploys production; `just docs-deploy pr-<number>` deploys a Preview.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cetra-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Astro writes `dist/404.html`; Starlight's pages end in a slash (trailingSlash: "always").
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Production is reached through its custom domain once one is attached; until then, workers.dev.
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
