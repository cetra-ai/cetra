  },
  { "name": "datasets", "path": "/acme/support-bot/datasets", "waitFor": "api-rate-limits" },
  { "name": "experiments", "path": "/acme/support-bot/experiments", "waitFor": "nightly-12" },
  {
    "name": "alerts",
