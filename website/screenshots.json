  },
  { "name": "sessions", "path": "/acme/support-bot/sessions?range=30d", "waitFor": "100 loaded" },
  { "name": "users", "path": "/acme/support-bot/users", "waitFor": "Top by cost" },
  { "name": "dashboard", "path": "/acme/support-bot/dashboard", "waitFor": "Tokens by type" },
  {
    "name": "sql-console",
    "path": "/acme/support-bot/sql",
    "waitFor": "Run",
    "actions": [
      {
        "click": ".cm-content",
        "type": "SELECT span_kind, count(*) AS spans, min(start_time) AS first_start\nFROM spans\nGROUP BY span_kind\nORDER BY span_kind"
      },
      { "click": "button:has-text('Run')" }
    ],
    "waitAfter": " rows · "
  },
  {
    "name": "evaluators",
    "path": "/acme/support-bot/evaluators",
