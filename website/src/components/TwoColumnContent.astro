---
// Starlight's TwoColumnContent (0.42.10) with one change: "On this page" is as wide as the
// left sidebar instead of taking half of the spare width, and the text column is centred in
// the space between the two sidebars. Re-copy the upstream file when Starlight changes it.
---

<div class="lg:sl-flex">
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
  <div class="main-pane"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .main-pane {
      isolation: isolate;
    }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        /* Keep the sidebar at the end of the row if it paints before the main pane is parsed. */
        margin-inline-start: auto;
        width: var(--sl-sidebar-width);
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: var(--sl-sidebar-width);
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        width: 100%;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto;

        order: 1;
        width: calc(100% - var(--sl-sidebar-width));
      }
    }
  }
</style>
