---
import { type loadProduct, STRENGTH_TITLES } from "../data/compare.mjs";
import StatusMark from "./StatusMark.astro";

type Product = ReturnType<typeof loadProduct>;
interface Props {
  them: Product;
  cetra: Product;
}
const { them, cetra } = Astro.props;
const strengths = (them.strengths ?? []).map((area) => ({
  area,
  title: STRENGTH_TITLES[area as keyof typeof STRENGTH_TITLES],
}));
---

<ol class="strengths">
  {
    strengths.map(({ area, title }) => (
      <li class="strength">
        <h3>{title}</h3>
        {area === "selfHostStack" && them.stack.length > 0 ? (
          <div class="stack" aria-label={`${them.name} runs ${them.stack.length} services; cetra runs one binary`}>
            <div class="side">
              <p class="who">{them.name}</p>
              <ul class="boxes" role="list">
                {them.stack.map((service) => (
                  <li class="box">{service}</li>
                ))}
              </ul>
            </div>
            <div class="side">
              <p class="who">cetra</p>
              <ul class="boxes" role="list">
                <li class="box box--cetra">cetra</li>
              </ul>
            </div>
          </div>
        ) : (
          <dl class="pair">
            <div class="row row--cetra">
              <dt>cetra</dt>
              <dd>
                <StatusMark status={cetra.facts[area].status} />
                {cetra.facts[area].short}
              </dd>
            </div>
            <div class="row">
              <dt>{them.name}</dt>
              <dd>
                <StatusMark status={them.facts[area].status} />
                {them.facts[area].short}
              </dd>
            </div>
          </dl>
        )}
      </li>
    ))
  }
</ol>

<style>
  .strengths {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 960px) {
    .strengths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .strength {
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  h3 {
    font-size: var(--text-lg);
  }
  .pair {
    margin: var(--space-5) 0 0;
    display: grid;
    gap: var(--space-3);
  }
  .row {
    display: grid;
    gap: var(--space-1);
  }
  dt {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }
  dd {
    margin: 0;
    display: flex;
    gap: var(--space-2);
    color: var(--fg-muted);
  }
  .row--cetra dd {
    color: var(--fg);
  }
  .stack {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .who {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }
  .boxes {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .box {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .box--cetra {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
