---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  /** What the screen shows, for screen readers. */
  alt: string;
  /** Text in the window's title bar, e.g. "Traces · Support bot". */
  label?: string;
  /** Let the frame run past the right edge of the container (hero). */
  bleed?: boolean;
  /** Fade the bottom of the frame into the band's background. */
  fade?: boolean;
  /** Load eagerly (only the hero). */
  eager?: boolean;
}
const { src, alt, label, bleed = false, fade = true, eager = false } = Astro.props;
---

<figure class:list={["frame", bleed && "frame--bleed", fade && "frame--fade"]}>
  <div class="scroll">
    <div class="bar" aria-hidden="true">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      {label && <span class="label">{label}</span>}
    </div>
    <Image
      src={src}
      alt={alt}
      widths={[720, 1080, 1440, 2160]}
      sizes="(min-width: 1200px) 1200px, 100vw"
      priority={eager}
    />
  </div>
</figure>

<style>
  .frame {
    margin: 0;
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--c-ink-2);
    box-shadow:
      var(--shadow-panel),
      0 0 0 1px rgb(45 212 191 / 0.06);
    overflow: hidden;
  }
  .frame--bleed {
    margin-right: calc(-1 * min(12vw, 160px));
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--c-ink-3);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .label {
    margin-left: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .frame--fade::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, var(--band-bg));
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .frame--bleed {
      margin-right: 0;
    }
    /* Design §4: on phones a screen is a scrollable crop, not a shrunken picture. */
    .scroll {
      overflow-x: auto;
    }
    .scroll :global(img) {
      width: 760px;
      max-width: none;
    }
  }
</style>
