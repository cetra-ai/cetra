---
interface Props {
  eyebrow?: string;
  title: string;
  lede: string;
  features?: string[];
  id?: string;
  /** The slot holds its own frame (a Frame): drop the visual's border, background and fade. */
  bare?: boolean;
  /** Put the picture on the left at 960 px and wider. */
  flip?: boolean;
  /**
   * Put the text above a full-width picture at 960 px and wider, for a screen too wide for the picture column
   * (the playground): its shot then shows at its own size, with the same text size as the hero.
   */
  wide?: boolean;
}
const {
  eyebrow,
  title,
  lede,
  features,
  id,
  bare = false,
  flip = false,
  wide = false,
} = Astro.props;
---
<div class:list={["chapter", flip && "chapter--flip", wide && "chapter--wide"]}>
  <div class="text">
    <div class="head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id}>{title}</h2>
    </div>
    <div class="body">
      <p class="lede">{lede}</p>
      {features && features.length > 0 && (
        <ul class="features bullets">
          {features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <div class:list={["visual", bare && "visual--bare"]}>
    <slot />
  </div>
</div>
<style>
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 960px) {
    .chapter {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
      align-items: center;
    }
    .chapter--flip {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
    .chapter--flip .text {
      order: 2;
    }
    .visual :global(.frame) {
      margin-inline: 0 auto;
    }
    .chapter--flip .visual :global(.frame) {
      margin-inline: auto 0;
    }
    .chapter.chapter--wide {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
    .chapter--wide .text {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: start;
    }
    .chapter--wide .visual :global(.frame) {
      margin-inline: auto;
    }
  }
  h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-3);
  }
  .lede {
    color: var(--fg-muted);
  }
  .features {
    margin: var(--space-5) 0 0;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .visual {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
    position: relative;
  }
  @media (max-width: 720px) {
    .visual {
      overflow-x: auto;
    }
  }
  .visual::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--band-bg));
    pointer-events: none;
  }
  /* Placed last so it overrides the .visual rules above, including the phone media query. */
  .visual--bare {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .visual--bare::after {
    content: none;
  }
</style>
