---
interface Props {
  id: string;
  labels: string[];
  /** The tab list's accessible name. */
  label?: string;
  /**
   * One URL hash per tab, without "#". With them, each tab's id is its hash, so a link to
   * `#<hash>` scrolls to the tab list and shows that tab, and selecting a tab writes its hash to
   * the URL.
   */
  hashes?: string[];
  class?: string;
}
const { id, labels, label, hashes, class: className } = Astro.props;
---
<div class:list={["tabs-root", className]} data-tabs data-tabs-id={id} data-tabs-hashes={hashes?.join(" ")}>
  <div class="tablist" role="tablist" aria-label={label}>
    {labels.map((text, i) => (
      <button
        type="button"
        role="tab"
        id={hashes?.[i] ?? `${id}-tab-${i}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
      >
        {text}
      </button>
    ))}
  </div>
  <slot />
</div>
<style>
  .tablist {
    overflow-x: auto;
  }
</style>
<script>
  import { wireTabs } from "../lib/tabs";

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const id = root.dataset.tabsId ?? "";
    const tabs = Array.from(
      root.querySelectorAll<HTMLElement>(":scope > [role=tablist] > [role=tab]"),
    );
    const panels = Array.from(root.querySelectorAll<HTMLElement>(":scope > [data-tab-panel]"));
    if (tabs.length !== panels.length) {
      console.error(`Tabs ${id}: ${tabs.length} labels, ${panels.length} panels`);
      return;
    }
    panels.forEach((panel, i) => {
      panel.id = `${id}-panel-${i}`;
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tabs[i].id);
      panel.hidden = i !== 0;
      tabs[i].setAttribute("aria-controls", panel.id);
    });
    wireTabs(tabs, panels);

    const hashes = root.dataset.tabsHashes?.split(" ") ?? [];
    if (hashes.length !== tabs.length) return;
    const initial = hashes.indexOf(window.location.hash.slice(1));
    if (initial > 0) tabs[initial].click();
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        history.replaceState(null, "", `#${hashes[i]}`);
      });
    });
  });
</script>
