---
import { MARKETING_ROUTES } from "../routes.mjs";
import { CONTACT_EMAIL, FOOTER } from "../site";
import Logo from "./Logo.astro";

const columns = FOOTER.map((column) => ({
  title: column.title,
  links: column.links.filter((i) => !i.route || MARKETING_ROUTES.includes(i.route)),
})).filter((column) => column.links.length > 0);
---
<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="brand">
        <Logo height={24} />
        <p class="muted">
          Open-source LLM observability and evaluation. One binary, on your machine or in our cloud.
        </p>
      </div>
      {
        columns.map((column) => (
          <div class="column">
            <h2 class="eyebrow">{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="legal">
      <p class="muted">
        © {new Date().getFullYear()} sebastiencs. The cetra core is MIT; enterprise features are under
        the Elastic License 2.0.
      </p>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--c-ink);
    padding-block: var(--space-8) var(--space-6);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--space-6);
  }
  .brand {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .column h2 {
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }
  .column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .column a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .column a:hover {
    color: var(--fg);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
  }
  .legal a {
    color: var(--fg-muted);
  }
  @media (max-width: 859px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 519px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
