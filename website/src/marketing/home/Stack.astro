---
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";

/** Each service of a typical self-hosted stack, and the part of cetra that replaces it. */
const ROWS = [
  ["Web app", "Web UI and API"],
  ["Worker", "Evaluations and alerts"],
  ["Postgres", "Embedded SQLite"],
  ["Redis", "Built-in job queue"],
  ["ClickHouse", "Storage engine"],
  ["Object storage", "Local disk, S3 optional"],
] as const;
---

<Section tone="ink" divider labelledby="stack-title">
  <SectionHeading
    eyebrow="One binary"
    title="Nothing else to run."
    id="stack-title"
    lede="Most LLM observability platforms you can self-host are a stack of services to install, upgrade and back up. cetra is one process and one data folder."
  />
  <div class="stack">
    <div class="heads" aria-hidden="true">
      <p class="eyebrow muted">What most alternatives make you run</p>
      <span></span>
      <p class="eyebrow accent">cetra · one process</p>
    </div>
    <ul class="rows">
      {
        ROWS.map(([service, part]) => (
          <li class="row">
            <span class="service">{service}</span>
            <span class="arrow" aria-hidden="true">→</span>
            <span class="visually-hidden">is replaced in cetra by</span>
            <span class="part">{part}</span>
          </li>
        ))
      }
    </ul>
    <div class="caps">
      <p class="cap">
        Six services to install, size, upgrade, monitor and back up. <a href="/compare/">Compare the stacks →</a>
      </p>
      <span></span>
      <p class="cap">One binary and one data folder. Upgrading means replacing a file; backing up is one command.</p>
    </div>
  </div>
</Section>

<style>
  .stack {
    --cols: minmax(0, 1fr) 2rem minmax(0, 1.15fr);
    margin-top: var(--space-7);
  }
  .heads,
  .row,
  .caps {
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: var(--space-3);
  }
  .heads {
    margin-bottom: var(--space-3);
  }
  .muted {
    color: var(--fg-muted);
  }
  .accent {
    color: var(--accent);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service,
  .part {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    overflow-wrap: anywhere;
  }
  /* The stack: one dashed tile per service, with a gap between rows. */
  .service {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--fg-muted);
    margin-block: var(--space-1);
    display: flex;
    align-items: center;
  }
  .arrow {
    align-self: center;
    justify-self: center;
    color: var(--fg-muted);
  }
  /* cetra: the parts join into one box, drawn across the rows. */
  .part {
    color: var(--fg);
    display: flex;
    align-items: center;
    border-inline: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .row:first-child .part {
    border-top: 1px solid var(--accent);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .row:last-child .part {
    border-bottom: 1px solid var(--accent);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .caps {
    margin-top: var(--space-4);
  }
  .cap {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  @media (max-width: 640px) {
    .stack {
      --cols: minmax(0, 1fr) 1.25rem minmax(0, 1fr);
    }
    .heads,
    .row,
    .caps {
      column-gap: var(--space-2);
    }
    .service,
    .part {
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-xs);
    }
    .caps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-3);
    }
  }
</style>
