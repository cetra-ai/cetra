---
import marketingAlerts from "../../assets/screenshots/marketing-alerts.png";
import marketingAssistant from "../../assets/screenshots/marketing-assistant.png";
import marketingIssue from "../../assets/screenshots/marketing-issue.png";
import marketingPlayground from "../../assets/screenshots/marketing-playground.png";
import marketingQueueReview from "../../assets/screenshots/marketing-queue-review.png";
import marketingTraceList from "../../assets/screenshots/marketing-trace-list.png";
import Chapter from "../components/Chapter.astro";
import Frame from "../components/Frame.astro";
import Section from "../components/Section.astro";
---

<Section tone="raised" id="product" labelledby="ch-trace">
  <Chapter
    bare
    id="ch-trace"
    eyebrow="Trace"
    title="See every call your app makes."
    lede="Send OpenTelemetry from any framework or SDK. Every LLM call, tool and retrieval lands in one tree, with tokens, cost and latency."
    features={["Sessions and users", "Cost per call and per model", "Live view while traces arrive", "Images and files in the payload"]}
  >
    <Frame src={marketingTraceList} alt="The trace list: a histogram of traces over time, and rows with start time, name, input and output." label="Traces" fade />
  </Chapter>
</Section>

<Section tone="ink" labelledby="ch-explore">
  <Chapter
    bare
    id="ch-explore"
    flip
    eyebrow="Explore"
    title="Find what went wrong, or ask."
    lede="Filter by anything, search the text of prompts and outputs, write SQL, or ask the built-in assistant in plain words."
    features={["Errors, slow and expensive in one click", "Full-text search", "A SQL console over your traces", "An assistant that drafts filters, SQL and dashboards, on your own LLM connection"]}
  >
    <Frame src={marketingAssistant} alt="The assistant answering which traces failed in the last day, with the filter it drafted." label="Assistant" fade={false} />
  </Chapter>
</Section>

<Section tone="teal" labelledby="ch-issues">
  <Chapter
    bare
    id="ch-issues"
    eyebrow="Issues"
    title="Problems find you."
    lede="cetra groups recurring errors, bad scores and unhappy users into issues. Fix the cause once instead of reading traces one by one."
    features={["Errors grouped by fingerprint, with no LLM call", "Bad scores and feedback clustered by meaning", "A fixed issue that comes back reopens", "Alert on it, queue it for review or turn it into a dataset"]}
  >
    <Frame src={marketingIssue} alt="An issue page: its state and actions, a daily chart of occurrences, example traces and its history." label="Issues" fade={false} />
  </Chapter>
</Section>

<Section tone="ink" labelledby="ch-evaluate">
  <Chapter
    bare
    id="ch-evaluate"
    flip
    eyebrow="Evaluate"
    title="Measure quality, with judges and people."
    lede="Score production traffic with LLM judges and checks, send traces to annotation queues for human review, and turn real traces into datasets and experiments."
    features={["LLM judges with sampling and a cost cap", "Checks: JSON, regex, schema, contains", "Annotation queues for human review", "Datasets and experiments from the SDKs"]}
  >
    <Frame src={marketingQueueReview} alt="An annotation queue's review form: the progress, the instructions and the score fields." label="Annotation queue" fade={false} />
  </Chapter>
</Section>

<Section tone="raised" labelledby="ch-prompts">
  <Chapter
    bare
    id="ch-prompts"
    eyebrow="Prompts"
    title="Change a prompt without a deploy."
    lede="Version your prompts in cetra and point a label such as production at the one to serve. Your app fetches it through the SDK, with a cache and a fallback. Try changes in the playground first."
    features={["Versions and labels", "SDK fetch with a cache and a fallback", "Up to four models side by side in the playground", "Cost, latency and scores per prompt version"]}
  >
    <Frame src={marketingPlayground} alt="The playground with a prompt version's messages and variables, and a model's answer with its tokens, cost and latency." label="Playground" fade={false} />
  </Chapter>
</Section>

<Section tone="ink" labelledby="ch-alert">
  <Chapter
    bare
    id="ch-alert"
    flip
    eyebrow="Alert"
    title="Know when it breaks."
    lede="Get told when the error rate, the cost, the latency, a score or an issue crosses your line, in Slack, by email or on a webhook."
    features={["Error rate", "Cost over a window", "p95 latency", "Judge score under a threshold", "Occurrences of an issue"]}
  >
    <Frame src={marketingAlerts} alt="The alerts page with its alert rules, three of them firing, and the recent alert events." label="Alerts" fade={false} />
  </Chapter>
</Section>
