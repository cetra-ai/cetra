---
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { AREAS, loadProduct, UNKNOWN_TEXT } from "../data/compare.mjs";

const SHORT_ROWS = ["selfHostStack", "selfHostLicence", "otel", "sql"];
const rows = AREAS.filter(([key]) => SHORT_ROWS.includes(key));
const cetra = loadProduct("cetra");
const others = ["langfuse", "phoenix", "langsmith"].map((slug) => loadProduct(slug));

/** "Unknown" is shown as the explanatory text, muted. */
const shown = (value: string) => (value === "Unknown" ? UNKNOWN_TEXT : value);
---

<Section tone="paper" divider labelledby="compare-title">
  <SectionHeading
    eyebrow="Compare"
    title="How cetra compares."
    id="compare-title"
    lede="Four facts that matter when you run it yourself. Full comparisons, with sources, for nine products."
  />
  <div class="table-wrap" tabindex="0">
    <table>
      <thead>
        <tr>
          <th scope="col">Area</th>
          <th scope="col">cetra</th>
          {
            others.map((product) => (
              <th scope="col">
                <a href={`/compare/${product.slug}/`}>{product.name}</a>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map(([key, label]) => (
            <tr>
              <th scope="row">{label}</th>
              <td class:list={[cetra.facts[key].value === "Unknown" && "muted"]}>
                {shown(cetra.facts[key].value)}
              </td>
              {others.map((product) => (
                <td class:list={[product.facts[key].value === "Unknown" && "muted"]}>
                  {shown(product.facts[key].value)}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="more">
    <Button href="/compare/" variant="secondary">All comparisons</Button>
  </div>
</Section>

<style>
  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-7);
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--fg-muted);
    width: 21%;
  }
  thead th:first-child,
  tbody th {
    width: 16%;
    font-weight: 600;
  }
  td {
    width: 21%;
  }
  .more {
    margin-top: var(--space-6);
  }
</style>
