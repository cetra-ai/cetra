---
import Button from "../components/Button.astro";
import CopyCommand from "../components/CopyCommand.astro";
import Section from "../components/Section.astro";
import StoryPicture from "../components/StoryPicture.astro";
import { CLOUD, DEMO_URL, INSTALL_COMMANDS } from "../site";
---

<Section tone="ink" pad="lg" id="top" labelledby="hero-title">
  <div class="hero">
    <div class="title">
      <p class="eyebrow">Open-source LLM observability</p>
      <h1 id="hero-title" class="hero-title">LLM observability in one binary.<br /><span class="accent">In our cloud or on your server.</span></h1>
    </div>
    <div class="pitch">
      <p class="lede">Traces, evaluations, prompts, issues and alerts for your AI app. Send your first trace to cetra Cloud in a minute, or run it yourself with nothing else to install or babysit.</p>
      <div class="actions">
        <Button href={CLOUD.signup} size="lg" external>Start free</Button>
        <Button href={DEMO_URL} size="lg" variant="secondary" external>Try the demo</Button>
      </div>
      <p class="small muted">Free plan with 100k units a month. The demo is the real cetra UI on sample data, with no sign-up.</p>
    </div>
    <div class="install">
      <p class="eyebrow">Or self-host it</p>
      <CopyCommand id="hero-install" commands={INSTALL_COMMANDS} note="What does this run?" noteHref="/docs/self-hosting/install/" />
    </div>
    <div class="visual">
      <StoryPicture picture="hero" fade={false} eager />
    </div>
  </div>
</Section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .title,
  .pitch,
  .install,
  .visual {
    min-width: 0;
  }
  .hero-title {
    font-size: var(--text-hero);
    margin-top: var(--space-3);
    max-width: 16ch;
  }
  .accent {
    color: var(--accent);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin-top: var(--space-4);
    max-width: 40rem;
  }
  .actions {
    margin-top: var(--space-6);
  }
  .small {
    font-size: var(--text-xs);
    margin-top: var(--space-3);
  }
  .install {
    margin-top: var(--space-7);
  }
  .install :global(.copy) {
    max-width: 640px;
    margin-top: var(--space-4);
  }
  .visual {
    margin-top: var(--space-8);
  }
  /* Wide screens: the title on the left and the pitch beside it; the install command and the story picture below,
     across both. "LLM observability", about 8.1em wide, shrinks to stay on one line. */
  @media (min-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-8);
      align-items: end;
    }
    .title {
      container-type: inline-size;
    }
    .hero-title {
      font-size: min(var(--text-hero), 100cqi / 8.2);
    }
    .lede {
      margin-top: 0;
    }
    .install,
    .visual {
      grid-column: 1 / -1;
    }
    /* The install command is centred, like the story tabs and picture under it. */
    .install {
      justify-self: center;
      width: min(100%, 640px);
      text-align: center;
    }
    .install :global(.copy) {
      text-align: left;
    }
  }
</style>
