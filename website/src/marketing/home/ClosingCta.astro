---
import Button from "../components/Button.astro";
import CopyCommand from "../components/CopyCommand.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { CLOUD, DEMO_URL, INSTALL_COMMANDS } from "../site";
---

<Section tone="raised" divider labelledby="cta-title">
  <SectionHeading
    align="center"
    title="Send your first trace today."
    id="cta-title"
    lede="Start free in cetra Cloud, click around the demo, or run cetra on your machine now."
  />
  <div class="actions">
    <Button href={CLOUD.signup} size="lg" external>Start free</Button>
    <Button href={DEMO_URL} size="lg" variant="secondary" external>Try the demo</Button>
  </div>
  <div class="install">
    <CopyCommand id="cta-install" commands={INSTALL_COMMANDS} />
  </div>
</Section>

<style>
  .actions {
    justify-content: center;
    margin-top: var(--space-6);
  }
  .install {
    max-width: 640px;
    margin: var(--space-6) auto 0;
  }
</style>
