---
import costByRepository from "../../assets/screenshots/marketing-coding-cost.png";
import Button from "../components/Button.astro";
import Frame from "../components/Frame.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<Section tone="teal" divider labelledby="coding-title">
  <div class="coding">
    <div class="text">
      <SectionHeading
        eyebrow="Coding agents"
        title="See what your coding agents cost."
        id="coding-title"
        lede="Trace Claude Code, Codex, Gemini CLI, GitHub Copilot, Qwen Code, Pi, OpenClaw, OpenCode, Goose and Oh My Pi. Every turn, model call and tool call, with tokens and API-equivalent cost per person, and per repository and branch where the agent reports them."
      />
      <ul class="features bullets">
        <li>One cetra agents setup command for Claude Code, Codex, Gemini CLI, Qwen Code, OpenClaw, OpenCode and Oh My Pi</li>
        <li>A ready-made Coding agents dashboard</li>
        <li>Claude Code: leave prompts and tool output out with --no-content</li>
        <li>API-equivalent cost, to compare people, repositories and sessions</li>
      </ul>
      <div class="docs-link">
        <Button href="/docs/integrations/claude-code/" variant="ghost">Set up Claude Code →</Button>
      </div>
    </div>
    <div class="visual">
      <Frame
        src={costByRepository}
        alt="A cetra dashboard card, Cost by repository: the coding agents' cost over the last 7 days, stacked by repository, rising from about $5 to $15 per six hours, with github.com/sebastiencs/chromium taking a growing share."
        label="Dashboards · Coding agents"
        fade={false}
      />
    </div>
  </div>
</Section>

<style>
  .coding {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .text {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
  }
  .features {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .docs-link {
    margin-left: -0.4rem;
  }
  .visual {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .coding {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
