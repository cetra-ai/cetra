---
import Section from "../components/Section.astro";
---

<Section tone="raised" pad="md">
  <div class="strip">
    <div class="item">
      <p class="eyebrow">Licence</p>
      <p class="value">MIT core</p>
    </div>
    <div class="item">
      <p class="eyebrow">Ingestion</p>
      <p class="value">OpenTelemetry, any framework</p>
    </div>
    <div class="item">
      <p class="eyebrow">Self-hosted</p>
      <p class="value">Free, no usage limits</p>
    </div>
    <div class="item">
      <p class="eyebrow">Cloud</p>
      <p class="value">EU or US region</p>
    </div>
  </div>
</Section>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-top: var(--space-2);
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .value {
      font-size: var(--text-lg);
    }
  }
</style>
