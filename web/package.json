{
  "name": "@cetra/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite --mode server",
    "gen:api": "openapi-typescript ../crates/server/openapi.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript ../crates/server/openapi.json -o src/api/schema.gen.ts --check",
    "gen:routes": "tsr generate",
    "typecheck": "pnpm gen:routes && tsc -b",
    "test": "pnpm gen:routes && vitest run",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "check": "pnpm check:static && pnpm test",
    "check:static": "pnpm check:api && biome check . && pnpm typecheck && pnpm build && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.24.1",
    "recharts": "3.11.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "sql-formatter": "15.10.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.165.0"
  },
  "msw": {
    "workerDirectory": [
      "msw"
    ]
  }
}
