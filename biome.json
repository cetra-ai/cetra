{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "web/**",
      "sdks/typescript/**",
      "node-cli/**",
      "tools/capture/ts/**",
      "tools/packaging/**",
      "website/**",
      "!**/dist",
      "!**/node_modules",
      "!website/dist",
      "!website/.astro",
      "!website/src/generated",
      "!website/**/*.md",
      "!web/src/api/schema.gen.ts",
      "!web/src/routeTree.gen.ts",
      "!web/msw/mockServiceWorker.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["web/src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
