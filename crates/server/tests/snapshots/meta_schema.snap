table usage_daily
CREATE TABLE usage_daily (
  org_id TEXT NOT NULL, project_id TEXT NOT NULL, day TEXT NOT NULL,
  spans INTEGER NOT NULL DEFAULT 0, bytes INTEGER NOT NULL DEFAULT 0,
  scores INTEGER NOT NULL DEFAULT 0,
  judge_input_tokens INTEGER NOT NULL DEFAULT 0, judge_output_tokens INTEGER NOT NULL DEFAULT 0,
  judge_cost_usd REAL NOT NULL DEFAULT 0, genai_log_events INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (org_id, project_id, day)
)

table usage_notices
CREATE TABLE usage_notices (
    org_id TEXT NOT NULL REFERENCES orgs(id) ON DELETE CASCADE,
    month TEXT NOT NULL,
    threshold INTEGER NOT NULL,
    sent_at INTEGER NOT NULL,
    PRIMARY KEY (org_id, month, threshold)
)

table users
CREATE TABLE users (
    id TEXT PRIMARY KEY,
    email TEXT NOT NULL UNIQUE,
    name TEXT,
    password_hash TEXT,
    email_verified_at INTEGER,
    is_instance_admin INTEGER NOT NULL DEFAULT 0,
    disabled_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
, email_verified_via TEXT
    CHECK (email_verified_via IS NULL
        OR email_verified_via IN ('mail_token', 'idp', 'invite', 'control_plane', 'operator')))

table web_sessions
CREATE TABLE web_sessions (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at INTEGER NOT NULL,
    last_seen_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    user_agent TEXT,
    ip TEXT
, sso_org_id TEXT REFERENCES orgs(id) ON DELETE SET NULL, via_provider INTEGER NOT NULL DEFAULT 0
    CHECK (via_provider IN (0, 1)))

index web_sessions_user
CREATE INDEX web_sessions_user ON web_sessions(user_id)
