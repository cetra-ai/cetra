       <ProjectReference Include="../../../Harness/Harness.csproj" />. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cetra.Capture</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
