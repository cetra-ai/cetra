<Project Sdk="Microsoft.NET.Sdk">

  <!-- Microsoft.Extensions.AI 11.0.0 with one tool round against the capture mock
       (IN8.4). Versions are exact pins; packages.lock.json records the resolved graph. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);MEAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="OpenTelemetry" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Harness/Harness.csproj" />
  </ItemGroup>

</Project>
