                  "value": {
                    "stringValue": "[{\"type\":\"function\",\"name\":\"python\",\"description\":\"Run Python in the persistent REPL (browser-harness helpers and raw cdp() pre-imported).\\n\\nBrowser helpers are synchronous (do not await them); variables survive calls; the last expression is printed. Cell deadline\\napplies; checkpoint small batches before it. screenshot() returns native images.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"string\"}},\"required\":[\"code\"],\"type\":\"object\"}},{\"type\":\"function\",\"name\":\"finish_from_repl\",\"description\":\"Deliver an existing value from the persistent REPL without printing or rewriting it. The Python expression must match the result schema of finish; for a string result use json.dumps(records) or an existing text variable. Evaluated once; ends the task after validation.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"expression\":{\"type\":\"string\"},\"success\":{\"default\":null,\"description\":\"true only when the result delivers what the task asked for, every value observed in this session; false when blocked, refused, partial, or a requested value was not found (never fill it from memory)\",\"anyOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]}},\"required\":[\"expression\"],\"type\":\"object\"}},{\"type\":\"function\",\"name\":\"finish\",\"description\":\"Submit the verified final result. For data already in the REPL, prefer finish_from_repl to avoid rewriting it. This ends the task.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"result\":{\"type\":\"string\"},\"success\":{\"default\":null,\"description\":\"true only when the result delivers what the task asked for, every value observed in this session; false when blocked, refused, partial, or a requested value was not found (never fill it from memory)\",\"anyOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]}},\"required\":[\"result\"],\"type\":\"object\"}}]"
