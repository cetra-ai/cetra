{
  "name": "support-reply",
  "type": "chat",
  "version": 2,
  "template": [
    {
      "role": "system",
      "content": "You are a friendly support agent for {{ product }}. Answer in {{ language }}."
    },
    {
      "type": "placeholder",
      "name": "history"
    },
    {
      "role": "user",
      "content": "{{ question }}"
    }
  ],
  "config": {
    "model": "gpt-4o",
    "params": {
      "temperature": 0.3,
      "max_tokens": 512
    }
  },
  "labels": [
    "latest",
    "staging"
  ],
  "variables": [
    "product",
    "language",
    "question"
  ],
  "placeholders": [
    "history"
  ],
  "commit_message": "Friendlier tone",
  "created_at": "2026-01-01T00:00:02.000000000Z"
}
